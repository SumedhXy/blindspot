{
  "name": "PromptWars Design Tokens",
  "description": "Three-layer design token system for the frontend",
  "layers": {
    "primitive": {
      "color": {
        "brand": {
          "500": "#CF4500",
          "600": "#B93D00",
          "700": "#8F2F00"
        },
        "neutral": {
          "000": "#F3F0EE",
          "100": "#FFFFFF",
          "200": "#DAD7D5",
          "300": "#696969",
          "400": "#141413",
          "500": "#222221"
        },
        "success": "#2E8B57",
        "warning": "#D97706",
        "danger": "#DC2626"
      },
      "radius": {
        "sm": "10px",
        "md": "20px",
        "lg": "32px"
      },
      "space": {
        "xs": "8px",
        "sm": "12px",
        "md": "16px",
        "lg": "24px",
        "xl": "32px"
      },
      "font": {
        "family": "Sofia Sans, system-ui, Arial, sans-serif"
      }
    },
    "semantic": {
      "color": {
        "primary": "{primitive.color.brand.500}",
        "background": "{primitive.color.neutral.000}",
        "surface": "{primitive.color.neutral.100}",
        "text": "{primitive.color.neutral.400}",
        "muted": "{primitive.color.neutral.300}",
        "border": "{primitive.color.neutral.200}",
        "success": "{primitive.color.success}",
        "warning": "{primitive.color.warning}",
        "danger": "{primitive.color.danger}"
      },
      "radius": {
        "card": "{primitive.radius.lg}",
        "input": "{primitive.radius.md}"
      }
    },
    "component": {
      "button": {
        "primaryBg": "{semantic.color.primary}",
        "primaryText": "#FFFFFF",
        "secondaryBg": "{semantic.color.surface}",
        "secondaryText": "{semantic.color.text}",
        "dangerBg": "{semantic.color.danger}"
      },
      "card": {
        "surface": "{semantic.color.surface}",
        "border": "{semantic.color.border}"
      }
    }
  }
}
