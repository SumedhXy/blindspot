# ==============================================================================
# BLINDSPOT / PROMPTWARS ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- 1. Google Gemini AI Engine Configuration ---
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30
AI_MOCK_FALLBACK=true

# --- 2. Backend Server Settings ---
APP_NAME="BlindSpot Reasoning Engine"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=dev-promptwars-insecure-secret-key-change-in-production

# --- 3. CORS & Allowed Origins ---
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000", "*"]

# --- 4. Database ---
DATABASE_URL=sqlite:///./app_data.db
DB_ECHO=false

# --- 5. Optional Google Cloud & Firebase Services ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=

# --- 6. Security & Rate Limiting ---
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=10
