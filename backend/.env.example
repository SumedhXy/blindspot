# Server Configuration
APP_NAME="PromptWars Starter Backend"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite:///./app_data.db

# Google AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_MOCK_FALLBACK=true

# Google Services (Optional - Adapter Based)
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=

# Security
SECRET_KEY=dev-promptwars-insecure-secret-key-change-in-prod
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=10
